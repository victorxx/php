            border-radius: 12px;
            padding:20px;
            
        }
        textarea{
            width:100%;
            min-height: 150px;
            border-radius: 12px;
            resize: vertical;

        }
        button{
            margin-top:20px;
            padding:20px 10px;
            border-radius: 12px;
            cursor: pointer;
        }
</style>
    </head>
    <body>
<form method="post">
<input class="input" type="text" name="titulo" placeholder="titulo">
<textarea name="texto" placeholder="digite o seu texto"></textarea>
<button type="submit">ENVIAR</button>
</form>
 </body>
 <?php
if($_POST){
$titulo=$_POST['titulo'];
 $texto=$_POST['texto'];
 $arquivo='pasta/'.$titulo.'.txt';
 file_put_contents($arquivo,$titulo."\n\n".$texto);

 echo 'gravado no arquivo....';
}
?>

