<?php

$pasta = 'pasta';
$url = isset($_GET['pagina']) ? $_GET['pagina'] : 'index';

if(is_dir($pasta)){
    $ler=glob($pasta.'/*.txt');
    if($ler){
        foreach($ler as $lendo){
            $nome=pathinfo($lendo,PATHINFO_FILENAME);
            if($nome!=$url){
                echo '<a href="?pagina='.$nome.'">'.$nome.'</a><br>';
            }
        }
    }
}
switch($url){
    default:
          $completo=$pasta.'/'.$url.'.txt';
          $lendo=file_get_contents($completo);
          echo $lendo;
          break;
    case 'index':
        echo 'BEM VINDO';
        break;
    


}

